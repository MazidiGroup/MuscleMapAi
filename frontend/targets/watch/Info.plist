<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Muscle Map</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Single-target watch app (watchOS 7+). No WatchKit extension exists. -->
	<key>WKApplication</key>
	<true/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.mazidigroup.apexai</string>
	<!-- Launching straight into the workout is the point: a set logged from the
	     wrist has to be one gesture, not a navigation. -->
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<false/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>watch-companion</string>
	</array>
	<!-- Siri is used only through App Intents. No speech is recorded by the app
	     and no transcript is retained. -->
	<key>NSSiriUsageDescription</key>
	<string>Muscle Map uses Siri so you can log a set by saying how many reps you did, without touching your phone.</string>
</dict>
</plist>
