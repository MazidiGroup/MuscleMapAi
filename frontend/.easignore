# EAS build ignore list — keeps the uploaded source tarball small and prevents
# stale caches / test artifacts from confusing the EAS builder.
node_modules
.pytest_cache
**/.pytest_cache
__pycache__
**/__pycache__
*.pyc
.venv
venv
env
.env.local
.env.*.local
.DS_Store
.vscode
.idea
coverage
dist
build
web-build
.expo
.next
test_reports

# EAS uses this file INSTEAD of .gitignore when it exists, so the generated
# native projects have to be excluded here too: prebuild regenerates them on
# the builder, and shipping ios/ (Pods + build) made every upload ~1.1 GB.
ios/
android/
**/build/
.expo/
*.ipa
*.xcarchive
appstore-shots/
__tests__/fixtures/
